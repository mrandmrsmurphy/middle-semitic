views:
  - type: table
    name: View
    filters:
      and:
        - file.folder == "Lexicon"
        - file.ext == "md"
    order:
      - file.name
      - arabic
      - aramaic
      - gloss
      - hebrew
      - pos
      - proto-semitic
      - root
    columnSize:
      file.name: 193
      note.arabic: 115
